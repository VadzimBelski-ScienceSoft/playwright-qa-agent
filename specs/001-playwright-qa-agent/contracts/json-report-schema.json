{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Playwright QA Agent Test Report",
  "description": "JSON schema for test reports generated by Playwright QA Agent",
  "type": "object",
  "required": [
    "session_id",
    "created",
    "duration",
    "summary",
    "requirements_tested",
    "results",
    "environment"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier (UUID)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created": {
      "type": "string",
      "description": "Report creation timestamp (ISO 8601)",
      "format": "date-time"
    },
    "duration": {
      "type": "number",
      "description": "Total test duration in seconds",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "needs_clarification", "skipped", "errors", "pass_rate"],
      "properties": {
        "total": {
          "type": "integer",
          "description": "Total requirements tested",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "description": "Requirements verified successfully",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "description": "Requirements that failed verification",
          "minimum": 0
        },
        "needs_clarification": {
          "type": "integer",
          "description": "Requirements needing clarification",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "description": "Requirements skipped",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "description": "Test execution errors",
          "minimum": 0
        },
        "pass_rate": {
          "type": "number",
          "description": "Percentage of passed tests (0.0-1.0)",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "requirements_tested": {
      "type": "integer",
      "description": "Number of requirements tested",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "description": "Individual verification results",
      "items": {
        "type": "object",
        "required": ["requirement_id", "status", "duration", "steps"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "description": "Requirement identifier",
            "pattern": "^REQ-\\d{3}$"
          },
          "requirement_title": {
            "type": "string",
            "description": "Requirement title"
          },
          "status": {
            "type": "string",
            "description": "Verification result status",
            "enum": ["passed", "failed", "needs_clarification", "skipped", "error"]
          },
          "duration": {
            "type": "number",
            "description": "Test duration in seconds",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "description": "Executed test steps",
            "items": {
              "type": "object",
              "required": ["action", "target", "success", "timestamp"],
              "properties": {
                "action": {
                  "type": "string",
                  "description": "Action type",
                  "enum": ["navigate", "fill", "click", "wait", "verify", "screenshot"]
                },
                "target": {
                  "type": "string",
                  "description": "Target element or page"
                },
                "value": {
                  "type": "string",
                  "description": "Value for fill/input actions"
                },
                "selector": {
                  "type": "string",
                  "description": "CSS/XPath selector used"
                },
                "success": {
                  "type": "boolean",
                  "description": "Whether step succeeded"
                },
                "timestamp": {
                  "type": "string",
                  "description": "When step executed (ISO 8601)",
                  "format": "date-time"
                },
                "duration": {
                  "type": "number",
                  "description": "Step duration in seconds",
                  "minimum": 0
                },
                "error_message": {
                  "type": "string",
                  "description": "Error if step failed"
                }
              }
            }
          },
          "screenshots": {
            "type": "array",
            "description": "Screenshot file paths (relative)",
            "items": {
              "type": "string"
            }
          },
          "logs": {
            "type": "array",
            "description": "Execution log messages",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "object",
            "description": "Error details if failed",
            "properties": {
              "message": {
                "type": "string",
                "description": "Error message"
              },
              "traceback": {
                "type": "string",
                "description": "Full error traceback"
              },
              "type": {
                "type": "string",
                "description": "Error type/class"
              }
            }
          },
          "clarification_reason": {
            "type": "string",
            "description": "Why clarification needed"
          },
          "refinement_suggestion": {
            "type": "string",
            "description": "Suggested requirement refinement"
          },
          "evidence": {
            "type": "object",
            "description": "Additional evidence",
            "additionalProperties": true
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Environment information",
      "required": ["python_version", "platform", "playwright_version"],
      "properties": {
        "python_version": {
          "type": "string",
          "description": "Python version"
        },
        "platform": {
          "type": "string",
          "description": "Operating system"
        },
        "playwright_version": {
          "type": "string",
          "description": "Playwright version"
        },
        "browser": {
          "type": "string",
          "description": "Browser type and version"
        },
        "headless": {
          "type": "boolean",
          "description": "Whether browser ran headless"
        }
      }
    },
    "files": {
      "type": "object",
      "description": "Generated file paths",
      "properties": {
        "junit_xml": {
          "type": "string",
          "description": "JUnit XML report path"
        },
        "json": {
          "type": "string",
          "description": "JSON report path"
        },
        "html": {
          "type": "string",
          "description": "HTML report path"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "requirements_file": {
          "type": "string",
          "description": "Path to requirements document"
        },
        "app_url": {
          "type": "string",
          "description": "Web application URL tested"
        },
        "username": {
          "type": "string",
          "description": "Authentication username"
        }
      }
    }
  }
}
